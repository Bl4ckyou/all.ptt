{
  "$comment": "Data-driven binary sources. Patterns match GitHub release asset names. Placeholders: {cpu}, {cuda}, {os}, {arch}.",
  "defaults": {
    "$comment": "Backend picked on first install. cpuOnlyVendors = hardware with no usable discrete GPU.",
    "cpuOnlyVendors": ["none", "intel"],
    "cpuOnly": "ik-llama-cpp",
    "gpu": "llama-cpp"
  },
  "settings": {
    "context-size": {
      "type": "number",
      "category": "model",
      "default": 4096,
      "min": 0,
      "descriptionKey": "setting-context-size-desc"
    },
    "gpu-layers": {
      "type": "number",
      "category": "gpu",
      "default": 0,
      "min": 0,
      "descriptionKey": "setting-gpu-layers-desc"
    },
    "threads": {
      "type": "number",
      "category": "cpu",
      "default": -1,
      "min": -1,
      "descriptionKey": "setting-threads-desc"
    },
    "batch-size": {
      "type": "number",
      "category": "performance",
      "default": 2048,
      "min": 1,
      "descriptionKey": "setting-batch-size-desc"
    },
    "flash-attention": {
      "type": "enum",
      "category": "gpu",
      "choices": ["auto", "on", "off"],
      "default": "auto",
      "descriptionKey": "setting-flash-attention-desc"
    },
    "parallel": {
      "type": "number",
      "category": "performance",
      "default": 1,
      "min": 1,
      "descriptionKey": "setting-parallel-desc"
    },
    "mmap": {
      "type": "boolean",
      "category": "performance",
      "default": true,
      "descriptionKey": "setting-mmap-desc"
    },
    "mlock": {
      "type": "boolean",
      "category": "performance",
      "default": false,
      "descriptionKey": "setting-mlock-desc"
    },
    "temperature": {
      "type": "number",
      "category": "sampling",
      "default": 0.8,
      "min": 0,
      "max": 2,
      "descriptionKey": "setting-temperature-desc"
    },
    "top-p": {
      "type": "number",
      "category": "sampling",
      "default": 0.95,
      "min": 0,
      "max": 1,
      "descriptionKey": "setting-top-p-desc"
    },
    "run-time-repack": {
      "type": "boolean",
      "category": "performance",
      "default": false,
      "descriptionKey": "setting-run-time-repack-desc"
    },
    "smart-expert-reduction": {
      "type": "number",
      "category": "performance",
      "default": 0,
      "min": 0,
      "descriptionKey": "setting-smart-expert-reduction-desc"
    }
  },
  "backends": {
    "llama-cpp": {
      "label": "llama.cpp",
      "repo": "ggml-org/llama.cpp",
      "defaultVariant": "auto",
      "binaries": ["llama-server", "llama-server.exe"],
      "settings": {
        "context-size": "--ctx-size",
        "gpu-layers": "--n-gpu-layers",
        "threads": "--threads",
        "batch-size": "--batch-size",
        "flash-attention": "--flash-attn",
        "parallel": "--parallel",
        "temperature": "--temp",
        "top-p": "--top-p"
      },
      "selection": [
        {
          "targets": ["linux-x64-cuda"],
          "include": "bin-ubuntu-cuda-.*-x64\\.tar\\.gz$",
          "exclude": ["^cudart-"],
          "prefer": ["cuda-12\\..*-x64\\.tar\\.gz$", "cuda-.*-x64\\.tar\\.gz$"]
        },
        { "targets": ["linux-x64-rocm"], "include": "bin-ubuntu-rocm-.*-x64\\.tar\\.gz$" },
        { "targets": ["linux-x64-vulkan"], "include": "bin-ubuntu-vulkan-x64\\.tar\\.gz$" },
        { "targets": ["linux-x64-cpu"], "include": "bin-ubuntu-x64\\.tar\\.gz$" },
        { "targets": ["linux-arm64-cpu"], "include": "bin-ubuntu-arm64\\.tar\\.gz$" },
        { "targets": ["darwin-arm64-metal"], "include": "bin-macos-arm64\\.tar\\.gz$" },
        { "targets": ["darwin-x64-cpu"], "include": "bin-macos-x64\\.tar\\.gz$" },
        {
          "targets": ["win-x64-cuda"],
          "include": "bin-win-cuda-.*-x64\\.zip$",
          "exclude": ["^cudart-"],
          "prefer": ["cuda-12\\..*-x64\\.zip$", "cuda-.*-x64\\.zip$"]
        },
        { "targets": ["win-x64-vulkan"], "include": "bin-win-vulkan-x64\\.zip$" },
        { "targets": ["win-x64-rocm"], "include": "bin-win-rocm-.*-x64\\.zip$" },
        { "targets": ["win-x64-cpu"], "include": "bin-win-cpu-x64\\.zip$" },
        { "targets": ["win-arm64-cpu"], "include": "bin-win-cpu-arm64\\.zip$" }
      ]
    },
    "ik-llama-cpp": {
      "label": "ik_llama.cpp (Thireus) — x86 CPU + NVIDIA",
      "repo": "Thireus/ik_llama.cpp",
      "defaultVariant": "cpu",
      "binaries": ["llama-server", "llama-server.exe"],
      "settings": {
        "context-size": "--ctx-size",
        "gpu-layers": "--gpu-layers",
        "threads": "--threads",
        "batch-size": "--batch-size",
        "flash-attention": "--flash-attn",
        "parallel": "--parallel",
        "mmap": { "flag": "--no-mmap", "invert": true },
        "mlock": "--mlock",
        "temperature": "--temp",
        "top-p": "--top-p",
        "run-time-repack": "--run-time-repack",
        "smart-expert-reduction": "--smart-expert-reduction"
      },
      "selection": [
        {
          "targets": ["linux-x64-cuda"],
          "include": "ik_llama-main-.*-bin-ubuntu-cuda-.*-x64-.*\\.zip$",
          "prefer": [
            "cuda-12\\.8-x64-{cpu}\\.zip$",
            "cuda-12\\..*-x64-{cpu}\\.zip$",
            "cuda-.*-x64-{cpu}\\.zip$",
            "cuda-.*-x64-avx2\\.zip$"
          ]
        },
        {
          "targets": ["linux-x64-cpu"],
          "include": "ik_llama-main-.*-bin-ubuntu-x64-.*\\.zip$",
          "prefer": ["-{cpu}\\.zip$", "-avx2\\.zip$"]
        },
        {
          "targets": ["win-x64-cuda"],
          "include": "ik_llama-main-.*-bin-win-cuda-.*-x64-.*\\.zip$",
          "prefer": [
            "cuda-12\\.8-x64-{cpu}\\.zip$",
            "cuda-12\\..*-x64-{cpu}\\.zip$",
            "cuda-.*-x64-{cpu}\\.zip$",
            "cuda-.*-x64-avx2\\.zip$"
          ]
        },
        {
          "targets": ["win-x64-cpu"],
          "include": "ik_llama-main-.*-bin-win-cpu-.*\\.zip$",
          "exclude": ["arm64"],
          "prefer": ["win-cpu-x64-{cpu}\\.zip$", "win-cpu-x64-avx2\\.zip$", "win-cpu-.*-{cpu}\\.zip$"]
        }
      ]
    }
  }
}
