{
  "$comment": "Data-driven binary sources. Patterns match GitHub release asset names. Placeholders: {cpu}, {cuda}, {os}, {arch}.",
  "defaults": {
    "$comment": "Backend picked on first install. cpuOnlyVendors = hardware with no usable discrete GPU.",
    "cpuOnlyVendors": ["none", "intel"],
    "cpuOnly": "ik-llama-cpp",
    "gpu": "llama-cpp"
  },
  "settings": {
    "context-size": { "type": "number", "category": "model", "default": 4096, "min": 0, "descriptionKey": "setting-context-size-desc" },
    "gpu-layers": { "type": "number", "category": "gpu", "default": 0, "min": 0, "descriptionKey": "setting-gpu-layers-desc" },
    "threads": { "type": "number", "category": "cpu", "default": -1, "min": -1, "descriptionKey": "setting-threads-desc" },
    "threads-batch": { "type": "number", "category": "cpu", "default": -1, "min": -1, "advanced": true, "descriptionKey": "setting-threads-batch-desc" },
    "cpu-range": { "type": "string", "category": "cpu", "advanced": true, "descriptionKey": "setting-cpu-range-desc" },
    "cpu-affinity": { "type": "boolean", "category": "cpu", "default": false, "advanced": true, "platforms": ["linux"], "descriptionKey": "setting-cpu-affinity-desc" },
    "numa": { "type": "enum", "category": "cpu", "choices": ["distribute", "isolate", "numactl"], "advanced": true, "platforms": ["linux"], "descriptionKey": "setting-numa-desc" },
    "process-priority": { "type": "number", "category": "cpu", "default": 0, "min": -1, "max": 3, "advanced": true, "descriptionKey": "setting-process-priority-desc" },
    "batch-size": { "type": "number", "category": "performance", "default": 2048, "min": 1, "descriptionKey": "setting-batch-size-desc" },
    "ubatch-size": { "type": "number", "category": "performance", "default": 512, "min": 1, "advanced": true, "descriptionKey": "setting-ubatch-size-desc" },
    "parallel": { "type": "number", "category": "performance", "default": 1, "min": 1, "descriptionKey": "setting-parallel-desc" },
    "continuous-batching": { "type": "boolean", "category": "performance", "default": true, "advanced": true, "descriptionKey": "setting-continuous-batching-desc" },
    "mmap": { "type": "boolean", "category": "performance", "default": true, "advanced": true, "descriptionKey": "setting-mmap-desc" },
    "mlock": { "type": "boolean", "category": "performance", "default": false, "advanced": true, "descriptionKey": "setting-mlock-desc" },
    "flash-attention": { "type": "enum", "category": "gpu", "choices": ["auto", "on", "off"], "default": "auto", "descriptionKey": "setting-flash-attention-desc" },
    "tensor-split": { "type": "string", "category": "gpu", "advanced": true, "descriptionKey": "setting-tensor-split-desc" },
    "main-gpu": { "type": "number", "category": "gpu", "default": 0, "min": 0, "advanced": true, "descriptionKey": "setting-main-gpu-desc" },
    "split-mode": { "type": "enum", "category": "gpu", "choices": ["layer", "row", "none"], "default": "layer", "advanced": true, "descriptionKey": "setting-split-mode-desc" },
    "kv-offload": { "type": "boolean", "category": "gpu", "default": true, "advanced": true, "descriptionKey": "setting-kv-offload-desc" },
    "cache-type-k": { "type": "enum", "category": "gpu", "choices": ["f32", "f16", "bf16", "f8_e4m3", "q8_0", "q4_0", "q4_1", "iq4_nl", "q5_0", "q5_1"], "default": "f16", "advanced": true, "descriptionKey": "setting-cache-type-k-desc" },
    "cache-type-v": { "type": "enum", "category": "gpu", "choices": ["f32", "f16", "bf16", "f8_e4m3", "q8_0", "q4_0", "q4_1", "iq4_nl", "q5_0", "q5_1"], "default": "f16", "advanced": true, "descriptionKey": "setting-cache-type-v-desc" },
    "temperature": { "type": "number", "category": "sampling", "default": 0.8, "min": 0, "max": 2, "descriptionKey": "setting-temperature-desc" },
    "top-p": { "type": "number", "category": "sampling", "default": 0.95, "min": 0, "max": 1, "descriptionKey": "setting-top-p-desc" },
    "top-k": { "type": "number", "category": "sampling", "default": 40, "min": 0, "advanced": true, "descriptionKey": "setting-top-k-desc" },
    "min-p": { "type": "number", "category": "sampling", "default": 0.05, "min": 0, "max": 1, "advanced": true, "descriptionKey": "setting-min-p-desc" },
    "repeat-penalty": { "type": "number", "category": "sampling", "default": 1.1, "min": 0, "advanced": true, "descriptionKey": "setting-repeat-penalty-desc" },
    "seed": { "type": "number", "category": "sampling", "default": -1, "min": -1, "advanced": true, "descriptionKey": "setting-seed-desc" },
    "n-predict": { "type": "number", "category": "sampling", "min": -1, "advanced": true, "descriptionKey": "setting-n-predict-desc" },
    "ctx-checkpoints": { "type": "number", "category": "performance", "min": 0, "advanced": true, "descriptionKey": "setting-ctx-checkpoints-desc" },
    "cache-ram": { "type": "number", "category": "performance", "min": -1, "advanced": true, "descriptionKey": "setting-cache-ram-desc" },
    "kv-unified": { "type": "boolean", "category": "gpu", "advanced": true, "descriptionKey": "setting-kv-unified-desc" },
    "context-shift": { "type": "boolean", "category": "performance", "advanced": true, "descriptionKey": "setting-context-shift-desc" },
    "swa-full": { "type": "boolean", "category": "performance", "advanced": true, "descriptionKey": "setting-swa-full-desc" },
    "repack": { "type": "boolean", "category": "performance", "default": true, "advanced": true, "descriptionKey": "setting-repack-desc" },
    "merge-qkv": { "type": "boolean", "category": "performance", "default": false, "advanced": true, "descriptionKey": "setting-merge-qkv-desc" },
    "draft-model": { "type": "path", "category": "speculative", "fileKind": "model", "descriptionKey": "setting-draft-model-desc" },
    "draft-gpu-layers": { "type": "number", "category": "speculative", "default": 0, "min": 0, "descriptionKey": "setting-draft-gpu-layers-desc" },
    "draft-context-size": { "type": "number", "category": "speculative", "default": 0, "min": 0, "advanced": true, "descriptionKey": "setting-draft-context-size-desc" },
    "draft-max": { "type": "number", "category": "speculative", "default": 3, "min": 0, "advanced": true, "descriptionKey": "setting-draft-max-desc" },
    "draft-cache-type-k": { "type": "enum", "category": "speculative", "choices": ["f32", "f16", "bf16", "f8_e4m3", "q8_0", "q4_0", "q4_1", "iq4_nl", "q5_0", "q5_1"], "default": "f16", "advanced": true, "descriptionKey": "setting-draft-cache-type-k-desc" },
    "draft-cache-type-v": { "type": "enum", "category": "speculative", "choices": ["f32", "f16", "bf16", "f8_e4m3", "q8_0", "q4_0", "q4_1", "iq4_nl", "q5_0", "q5_1"], "default": "f16", "advanced": true, "descriptionKey": "setting-draft-cache-type-v-desc" },
    "draft-threads": { "type": "number", "category": "speculative", "default": -1, "min": -1, "advanced": true, "descriptionKey": "setting-draft-threads-desc" },
    "mmproj": { "type": "path", "category": "multimodal", "fileKind": "mmproj", "descriptionKey": "setting-mmproj-desc" },
    "mmproj-offload": { "type": "boolean", "category": "multimodal", "default": true, "advanced": true, "descriptionKey": "setting-mmproj-offload-desc" },
    "image-min-tokens": { "type": "number", "category": "multimodal", "min": 0, "advanced": true, "descriptionKey": "setting-image-min-tokens-desc" },
    "image-max-tokens": { "type": "number", "category": "multimodal", "min": 0, "advanced": true, "descriptionKey": "setting-image-max-tokens-desc" },
    "mtp-requantize": { "type": "enum", "category": "mtp", "choices": ["f32", "f16", "bf16", "f8_e4m3", "q8_0", "q4_0", "q4_1", "iq4_nl", "q5_0", "q5_1"], "advanced": true, "descriptionKey": "setting-mtp-requantize-desc" },
    "spec-type": { "type": "enum", "category": "speculative", "descriptionKey": "setting-spec-type-desc" },
    "spec-type-secondary": { "type": "enum", "category": "speculative", "descriptionKey": "setting-spec-type-secondary-desc" },
    "spec-n-max": { "type": "number", "category": "speculative", "min": 0, "advanced": true, "dependsOn": { "setting": "spec-type" }, "descriptionKey": "setting-spec-n-max-desc" },
    "spec-n-min": { "type": "number", "category": "speculative", "min": 0, "advanced": true, "dependsOn": { "setting": "spec-type" }, "descriptionKey": "setting-spec-n-min-desc" },
    "spec-p-min": { "type": "number", "category": "speculative", "min": 0, "max": 1, "advanced": true, "dependsOn": { "setting": "spec-type" }, "descriptionKey": "setting-spec-p-min-desc" },
    "spec-heads": { "type": "number", "category": "speculative", "min": 1, "advanced": true, "dependsOn": { "setting": "spec-type", "values": ["mtp"] }, "descriptionKey": "setting-spec-heads-desc" },
    "spec-ngram-size-n": { "type": "number", "category": "speculative", "min": 1, "advanced": true, "dependsOn": { "setting": "spec-type-secondary", "includes": "ngram" }, "descriptionKey": "setting-spec-ngram-size-n-desc" },
    "spec-ngram-size-m": { "type": "number", "category": "speculative", "min": 1, "advanced": true, "dependsOn": { "setting": "spec-type-secondary", "includes": "ngram" }, "descriptionKey": "setting-spec-ngram-size-m-desc" },
    "spec-ngram-min-hits": { "type": "number", "category": "speculative", "min": 1, "advanced": true, "dependsOn": { "setting": "spec-type-secondary", "includes": "ngram" }, "descriptionKey": "setting-spec-ngram-min-hits-desc" },
    "spec-ngram-simple-size-n": { "type": "number", "category": "speculative", "min": 1, "advanced": true, "dependsOn": { "setting": "spec-type-secondary", "values": ["ngram-simple"] }, "descriptionKey": "setting-spec-ngram-size-n-desc" },
    "spec-ngram-simple-size-m": { "type": "number", "category": "speculative", "min": 1, "advanced": true, "dependsOn": { "setting": "spec-type-secondary", "values": ["ngram-simple"] }, "descriptionKey": "setting-spec-ngram-size-m-desc" },
    "spec-ngram-simple-min-hits": { "type": "number", "category": "speculative", "min": 1, "advanced": true, "dependsOn": { "setting": "spec-type-secondary", "values": ["ngram-simple"] }, "descriptionKey": "setting-spec-ngram-min-hits-desc" },
    "spec-ngram-map-k-size-n": { "type": "number", "category": "speculative", "min": 1, "advanced": true, "dependsOn": { "setting": "spec-type-secondary", "values": ["ngram-map-k"] }, "descriptionKey": "setting-spec-ngram-size-n-desc" },
    "spec-ngram-map-k-size-m": { "type": "number", "category": "speculative", "min": 1, "advanced": true, "dependsOn": { "setting": "spec-type-secondary", "values": ["ngram-map-k"] }, "descriptionKey": "setting-spec-ngram-size-m-desc" },
    "spec-ngram-map-k-min-hits": { "type": "number", "category": "speculative", "min": 1, "advanced": true, "dependsOn": { "setting": "spec-type-secondary", "values": ["ngram-map-k"] }, "descriptionKey": "setting-spec-ngram-min-hits-desc" },
    "spec-ngram-map-k4v-size-n": { "type": "number", "category": "speculative", "min": 1, "advanced": true, "dependsOn": { "setting": "spec-type-secondary", "values": ["ngram-map-k4v"] }, "descriptionKey": "setting-spec-ngram-size-n-desc" },
    "spec-ngram-map-k4v-size-m": { "type": "number", "category": "speculative", "min": 1, "advanced": true, "dependsOn": { "setting": "spec-type-secondary", "values": ["ngram-map-k4v"] }, "descriptionKey": "setting-spec-ngram-size-m-desc" },
    "spec-ngram-map-k4v-min-hits": { "type": "number", "category": "speculative", "min": 1, "advanced": true, "dependsOn": { "setting": "spec-type-secondary", "values": ["ngram-map-k4v"] }, "descriptionKey": "setting-spec-ngram-min-hits-desc" },
    "spec-ngram-mod-n-min": { "type": "number", "category": "speculative", "min": 1, "advanced": true, "dependsOn": { "setting": "spec-type-secondary", "values": ["ngram-mod"] }, "descriptionKey": "setting-spec-n-min-desc" },
    "spec-ngram-mod-n-max": { "type": "number", "category": "speculative", "min": 1, "advanced": true, "dependsOn": { "setting": "spec-type-secondary", "values": ["ngram-mod"] }, "descriptionKey": "setting-spec-n-max-desc" },
    "spec-ngram-mod-n-match": { "type": "number", "category": "speculative", "min": 1, "advanced": true, "dependsOn": { "setting": "spec-type-secondary", "values": ["ngram-mod"] }, "descriptionKey": "setting-spec-ngram-size-n-desc" },
    "spec-suffix-min-match-len": { "type": "number", "category": "speculative", "min": 1, "advanced": true, "dependsOn": { "setting": "spec-type-secondary", "values": ["suffix"] }, "descriptionKey": "setting-spec-suffix-min-match-len-desc" },
    "spec-suffix-max-depth": { "type": "number", "category": "speculative", "min": 1, "advanced": true, "dependsOn": { "setting": "spec-type-secondary", "values": ["suffix"] }, "descriptionKey": "setting-spec-suffix-max-depth-desc" },
    "spec-suffix-corpus": { "type": "string", "category": "speculative", "advanced": true, "dependsOn": { "setting": "spec-type-secondary", "values": ["suffix"] }, "descriptionKey": "setting-spec-suffix-corpus-desc" }
  },
  "backends": {
    "llama-cpp": {
      "label": "llama.cpp",
      "shortLabel": "llama.cpp",
      "repo": "ggml-org/llama.cpp",
      "defaultVariant": "auto",
      "binaries": ["llama-server", "llama-server.exe"],
      "categorySpecTypes": {
        "assistant": "draft-simple",
        "mtp": "draft-mtp",
        "dflash": "draft-dflash",
        "dflash2": "draft-dflash2",
        "dspark": "draft-dspark",
        "eagle3": "draft-eagle3",
        "lilicorr": "draft-lilicorr",
        "other": "draft-simple"
      },
      "settings": {
        "context-size": "--ctx-size",
        "gpu-layers": "--n-gpu-layers",
        "threads": "--threads",
        "threads-batch": "--threads-batch",
        "cpu-range": "--cpu-range",
        "numa": "--numa",
        "process-priority": "--prio",
        "batch-size": "--batch-size",
        "ubatch-size": "--ubatch-size",
        "parallel": "--parallel",
        "continuous-batching": { "flag": "--no-cont-batching", "invert": true },
        "flash-attention": "--flash-attn",
        "tensor-split": "--tensor-split",
        "main-gpu": "--main-gpu",
        "split-mode": "--split-mode",
        "kv-offload": { "flag": "--no-kv-offload", "invert": true },
        "cache-type-k": "--cache-type-k",
        "cache-type-v": "--cache-type-v",
        "temperature": "--temp",
        "top-p": "--top-p",
        "top-k": "--top-k",
        "min-p": "--min-p",
        "repeat-penalty": "--repeat-penalty",
        "seed": "--seed",
        "n-predict": "--n-predict",
        "ctx-checkpoints": "--ctx-checkpoints",
        "cache-ram": "--cache-ram",
        "kv-unified": "--kv-unified",
        "context-shift": "--context-shift",
        "swa-full": "--swa-full",
        "repack": { "flag": "--no-repack", "invert": true },
        "draft-model": "--model-draft",
        "draft-gpu-layers": "--gpu-layers-draft",
        "draft-max": "--spec-draft-n-max",
        "draft-cache-type-k": "--cache-type-k-draft",
        "draft-cache-type-v": "--cache-type-v-draft",
        "draft-threads": "--threads-draft",
        "mmproj": "--mmproj",
        "mmproj-offload": { "flag": "--no-mmproj-offload", "invert": true },
        "image-min-tokens": "--image-min-tokens",
        "image-max-tokens": "--image-max-tokens",
        "spec-type": {
          "flag": "--spec-type",
          "compose": "spec",
          "stage": true,
          "choices": [
            "none",
            "draft-simple",
            "draft-eagle3",
            "draft-mtp",
            "draft-dflash",
            "draft-dspark",
            "draft-dflash2",
            "draft-lilicorr"
          ]
        },
        "spec-type-secondary": {
          "flag": "--spec-type",
          "compose": "spec",
          "stage": true,
          "choices": ["none", "ngram-simple", "ngram-map-k", "ngram-map-k4v", "ngram-mod", "ngram-cache"]
        },
        "spec-n-min": "--spec-draft-n-min",
        "spec-p-min": "--spec-draft-p-min",
        "spec-ngram-simple-size-n": "--spec-ngram-simple-size-n",
        "spec-ngram-simple-size-m": "--spec-ngram-simple-size-m",
        "spec-ngram-simple-min-hits": "--spec-ngram-simple-min-hits",
        "spec-ngram-map-k-size-n": "--spec-ngram-map-k-size-n",
        "spec-ngram-map-k-size-m": "--spec-ngram-map-k-size-m",
        "spec-ngram-map-k-min-hits": "--spec-ngram-map-k-min-hits",
        "spec-ngram-map-k4v-size-n": "--spec-ngram-map-k4v-size-n",
        "spec-ngram-map-k4v-size-m": "--spec-ngram-map-k4v-size-m",
        "spec-ngram-map-k4v-min-hits": "--spec-ngram-map-k4v-min-hits",
        "spec-ngram-mod-n-min": "--spec-ngram-mod-n-min",
        "spec-ngram-mod-n-max": "--spec-ngram-mod-n-max",
        "spec-ngram-mod-n-match": "--spec-ngram-mod-n-match"
      },
      "selection": [
        {
          "targets": ["linux-x64-cuda"],
          "include": "bin-ubuntu-cuda-.*-x64\\.tar\\.gz$",
          "exclude": ["^cudart-"],
          "prefer": ["cuda-.*-x64\\.tar\\.gz$"],
          "runtime": "cudart"
        },
        { "targets": ["linux-x64-rocm"], "include": "bin-ubuntu-rocm-.*-x64\\.tar\\.gz$" },
        { "targets": ["linux-x64-vulkan"], "include": "bin-ubuntu-vulkan-x64\\.tar\\.gz$" },
        { "targets": ["linux-x64-cpu"], "include": "bin-ubuntu-x64\\.tar\\.gz$" },
        { "targets": ["linux-arm64-cpu"], "include": "bin-ubuntu-arm64\\.tar\\.gz$" },
        { "targets": ["darwin-arm64-metal"], "include": "bin-macos-arm64\\.tar\\.gz$" },
        { "targets": ["darwin-x64-cpu"], "include": "bin-macos-x64\\.tar\\.gz$" },
        {
          "targets": ["win-x64-cuda"],
          "include": "bin-win-cuda-.*-x64\\.zip$",
          "exclude": ["^cudart-"],
          "prefer": ["cuda-.*-x64\\.zip$"],
          "runtime": "cudart"
        },
        { "targets": ["win-x64-vulkan"], "include": "bin-win-vulkan-x64\\.zip$" },
        { "targets": ["win-x64-rocm"], "include": "bin-win-rocm-.*-x64\\.zip$" },
        { "targets": ["win-x64-cpu"], "include": "bin-win-cpu-x64\\.zip$" },
        { "targets": ["win-arm64-cpu"], "include": "bin-win-cpu-arm64\\.zip$" }
      ]
    },
    "ik-llama-cpp": {
      "label": "ik_llama.cpp (Thireus) — x86 CPU + NVIDIA",
      "shortLabel": "ik_llama.cpp",
      "repo": "Thireus/ik_llama.cpp",
      "defaultVariant": "cpu",
      "binaries": ["llama-server", "llama-server.exe"],
      "categorySpecTypes": {
        "assistant": "draft",
        "mtp": "mtp",
        "dflash": "dflash",
        "dspark": "dspark",
        "other": "draft"
      },
      "settings": {
        "context-size": "--ctx-size",
        "gpu-layers": "--gpu-layers",
        "threads": "--threads",
        "threads-batch": "--threads-batch",
        "cpu-range": "--cpu-range",
        "cpu-affinity": "--cpu-affinity",
        "numa": "--numa",
        "batch-size": "--batch-size",
        "ubatch-size": "--ubatch-size",
        "parallel": "--parallel",
        "continuous-batching": { "flag": "--no-cont-batching", "invert": true },
        "mmap": { "flag": "--no-mmap", "invert": true },
        "mlock": "--mlock",
        "flash-attention": "--flash-attn",
        "tensor-split": "--tensor-split",
        "main-gpu": "--main-gpu",
        "split-mode": "--split-mode",
        "kv-offload": { "flag": "--no-kv-offload", "invert": true },
        "cache-type-k": "--cache-type-k",
        "cache-type-v": "--cache-type-v",
        "temperature": "--temp",
        "top-p": "--top-p",
        "top-k": "--top-k",
        "min-p": "--min-p",
        "repeat-penalty": "--repeat-penalty",
        "seed": "--seed",
        "n-predict": "--predict",
        "ctx-checkpoints": "--ctx-checkpoints",
        "cache-ram": "--cache-ram",
        "repack": { "flag": "--run-time-repack", "default": false },
        "merge-qkv": "--merge-qkv",
        "draft-model": "--model-draft",
        "draft-gpu-layers": "--gpu-layers-draft",
        "draft-context-size": "--ctx-size-draft",
        "draft-cache-type-k": "--cache-type-k-draft",
        "draft-cache-type-v": "--cache-type-v-draft",
        "draft-threads": "--threads-draft",
        "mmproj": "--mmproj",
        "mmproj-offload": { "flag": "--no-mmproj-offload", "invert": true },
        "image-min-tokens": "--image-min-tokens",
        "image-max-tokens": "--image-max-tokens",
        "mtp-requantize": "--mtp-requantize-output-tensor",
        "spec-type": {
          "flag": "--spec-type",
          "compose": "spec",
          "stage": true,
          "choices": ["none", "draft", "dflash", "dspark", "mtp"]
        },
        "spec-type-secondary": {
          "flag": "--spec-type",
          "compose": "spec",
          "stage": true,
          "choices": [
            "none",
            "ngram-cache",
            "ngram-simple",
            "ngram-map-k",
            "ngram-map-k4v",
            "ngram-mod",
            "suffix"
          ]
        },
        "spec-n-max": { "compose": "spec", "key": "n_max", "stageId": "spec-type" },
        "spec-n-min": { "compose": "spec", "key": "n_min", "stageId": "spec-type" },
        "spec-p-min": { "compose": "spec", "key": "p_min", "stageId": "spec-type" },
        "spec-heads": { "compose": "spec", "key": "heads", "stageId": "spec-type" },
        "spec-ngram-size-n": { "compose": "spec", "key": "ngram_size_n", "stageId": "spec-type-secondary" },
        "spec-ngram-size-m": { "compose": "spec", "key": "ngram_size_m", "stageId": "spec-type-secondary" },
        "spec-ngram-min-hits": { "compose": "spec", "key": "ngram_min_hits", "stageId": "spec-type-secondary" },
        "spec-suffix-min-match-len": { "compose": "spec", "key": "suffix_min_match_len", "stageId": "spec-type-secondary" },
        "spec-suffix-max-depth": { "compose": "spec", "key": "suffix_max_depth", "stageId": "spec-type-secondary" },
        "spec-suffix-corpus": { "compose": "spec", "key": "suffix_corpus", "stageId": "spec-type-secondary" }
      },
      "selection": [
        {
          "targets": ["linux-x64-cuda"],
          "include": "ik_llama-main-.*-bin-ubuntu-cuda-.*-x64-.*\\.zip$",
          "exclude": ["cudart"],
          "prefer": ["cuda-.*-x64-{cpu}\\.zip$", "cuda-.*-x64-avx2\\.zip$"],
          "runtime": "cudart"
        },
        {
          "targets": ["linux-x64-cpu"],
          "include": "ik_llama-main-.*-bin-ubuntu-x64-.*\\.zip$",
          "prefer": ["-{cpu}\\.zip$", "-avx2\\.zip$"]
        },
        {
          "targets": ["win-x64-cuda"],
          "include": "ik_llama-main-.*-bin-win-cuda-.*-x64-.*\\.zip$",
          "exclude": ["cudart"],
          "prefer": ["cuda-.*-x64-{cpu}\\.zip$", "cuda-.*-x64-avx2\\.zip$"],
          "runtime": "cudart"
        },
        {
          "targets": ["win-x64-cpu"],
          "include": "ik_llama-main-.*-bin-win-cpu-.*\\.zip$",
          "exclude": ["arm64"],
          "prefer": ["win-cpu-x64-{cpu}\\.zip$", "win-cpu-x64-avx2\\.zip$", "win-cpu-.*-{cpu}\\.zip$"]
        }
      ]
    }
  }
}
